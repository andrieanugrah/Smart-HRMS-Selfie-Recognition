# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# Socket.io & Internal Communication
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
SOCKET_INTERNAL_URL=http://localhost:5000
INTERNAL_SOCKET_SECRET=smart-hrms-internal-secret

# Express Server
SERVER_PORT=5000

# Face Match Threshold
FACE_MATCH_THRESHOLD=0.6
NEXT_PUBLIC_FACE_MATCH_THRESHOLD=0.6

# Office Location (Jakarta)
OFFICE_LAT=-6.2088
OFFICE_LNG=106.8456
OFFICE_RADIUS_METERS=100
NEXT_PUBLIC_OFFICE_LAT=-6.2088
NEXT_PUBLIC_OFFICE_LNG=106.8456
NEXT_PUBLIC_OFFICE_RADIUS_METERS=100
